# 依赖
node_modules/
.pnpm-store/

# 构建产物与工具缓存
dist/
.astro/
*.tsbuildinfo

# 测试覆盖率（本项目未接入测试，仅作兜底）
coverage/

# 构建时生成的数据（prebuild 会自动写入，缺失会导致构建失败）
src/components/contributors.json

# 环境变量
.env
.env.*
!.env.example

# 编辑器与 IDE
.vscode/*
!.vscode/extensions.json
.idea/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 证书
*.pem

# 系统文件
.DS_Store
Thumbs.db

# Yarn PnP（本项目用 pnpm，留作兜底）
.pnp.*
