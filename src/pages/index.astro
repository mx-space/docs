---
import Base from '@/layouts/base.astro';
import Home from '@/components/home';
import { LandingHero } from '@/components/landing-hero';
import { PreviewImages } from '@/components/preview-images';
import { Features } from '@/components/features';
import { Testimonials } from '@/components/testimonials';
import { Contributors } from '@/components/contributors';
import { responsiveImage } from '@/lib/images';
import uwu from '@/assets/uwu.png';
import yohaku from '@/assets/previews/yohaku.png';
import shiro from '@/assets/previews/shiro.png';
import dashboard from '@/assets/previews/dashboard.png';

// 首页两个岛屿（Home client:load、PreviewImages client:load）内部无法使用 astro:assets，
// 图片优化统一在 .astro 层完成后以可序列化 props 下发。
// hero logo 显示宽 192/256px → 2x/3x 取 384/512；轮播容器 max-w-6xl(1152px) → 至 1920 覆盖大屏。
const heroLogo = await responsiveImage(
  uwu,
  [256, 384, 512],
  '(min-width: 768px) 256px, 192px',
);
const previewSrcSets = await Promise.all(
  [yohaku, shiro, dashboard].map((image) =>
    responsiveImage(image, [640, 960, 1280, 1600, 1920], '(min-width: 1152px) 1152px, 100vw'),
  ),
);
const previews = [
  { name: '余白/Yohaku', ...previewSrcSets[0] },
  { name: '白/Shiro', ...previewSrcSets[1] },
  { name: '控制面板/Dashboard', ...previewSrcSets[2] },
];

// JSON-LD 内容与迁移前的首页保持一致（name/description/offers/author 语义不变）
const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Mix Space',
  description: 'AI 驱动型内容管理系统，为个人博客、创作者主页和内容网站打造。',
  url: 'https://mx-space.js.org',
  applicationCategory: 'ContentManagementSystem',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Mix Space Team',
    url: 'https://github.com/mx-space',
  },
};
---

<!-- 首页自指 canonical = 站点根（旧站硬编码站点根是 bug，这里仍是站点根但改为正确的自指） -->
<Base canonical={Astro.site?.origin}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(softwareApplicationSchema)}
  />
  <Home client:load pathname={Astro.url.pathname}>
    <LandingHero logo={heroLogo} />
    <!-- 自动轮播需要 JS，因此单独作为岛屿水合（见 R10：slot 内岛屿是否水合待构建验证） -->
    <PreviewImages client:load previews={previews} />
    <Features />
    <Testimonials />
    <Contributors />
  </Home>
</Base>
